<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView android:id="@+id/z_wait" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:background="@android:color/transparent" />
        <TextView android:id="@+id/z_block" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:background="@android:color/transparent" />
        <TextView android:id="@+id/z_run" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:text="" android:background="@android:color/transparent" />
        <TextView android:id="@+id/z_more" android:layout_width="52dp"
            android:layout_height="match_parent"
            android:text="" android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
